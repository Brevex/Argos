{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argos",
  "mainBinaryName": "argos-shell",
  "identifier": "org.argos.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argos",
        "width": 980,
        "height": 720,
        "minWidth": 900,
        "minHeight": 650,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/argos"
    ],
    "category": "Utility",
    "shortDescription": "Forensic recovery of deleted images",
    "longDescription": "Recovers permanently deleted images from block devices. The medium is opened read-only and never written to; every artifact is recorded with the extents it came from and the hash of what was written.",
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "polkit"
        ],
        "files": {
          "/usr/share/polkit-1/actions/org.argos.shell.policy": "packaging/org.argos.shell.policy"
        }
      },
      "rpm": {
        "depends": [
          "polkit"
        ],
        "files": {
          "/usr/share/polkit-1/actions/org.argos.shell.policy": "packaging/org.argos.shell.policy"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
