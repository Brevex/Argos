# Cargo build output, wherever it appears. Not root-anchored: the fuzz crates
# and the shell are cargo projects of their own, each with a target directory
# beside its manifest.
target/

# The shell's frontend: installed packages and the bundle Vite produces from
# the sources beside them. `package-lock.json` is committed, so the tree that
# built a release is reproducible.
/crates/argos_ui/ui/node_modules/
/crates/argos_ui/ui/dist/

# Tauri regenerates these from tauri.conf.json and the capabilities on every
# build. The inputs are committed; the output is not.
/crates/argos_ui/gen/

# Where the engine binary is copied, as `argos-<target-triple>`, so the bundler
# can place it beside the shell. Produced by `cargo build -p argos` — by the
# bundle step of .github/workflows/release.yml, or by hand before a local
# `tauri build` (A-SUPPORT-DECLARED).
/crates/argos_ui/binaries/
